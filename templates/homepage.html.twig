{% extends 'base.html.twig' %}

{% block title '' %}

{% block header_link_target ' data-turbo-frame="homepage-sidebar"' %}

{% block body %}
    <div class="{% block homepage_class 'Homepage' %}">
        <turbo-frame class="Homepage__sidebar" id="homepage-sidebar" data-turbo-action="advance">
            {% block homepage_sidebar '' %}
        </turbo-frame>

        <div class="Homepage__mapContainer">
            {{ ux_map(map, {style: 'height: 100%;', 'data-controller': 'homepage_map'}) }}
        </div>
    </div>
{% endblock %}
