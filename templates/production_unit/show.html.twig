{% extends 'homepage.html.twig' %}

{% block homepage_sidebar %}
    <div>
        <h2>
            {{ production_unit.name }}
        </h2>

        <ul>
            {% for values in production_unit.values %}
                <li>
                    {{ values.type.name }}
                    <dl>
                        <dt>Connu depuis</dt>
                        <dd>{{ values.startDate | format_datetime('long', 'none') }}</dd>
                        <dt>Connu jusqu'à</dt>
                        <dd>{{ values.endDate ? value.endDate | format_datetime('long', 'none') : 'En service' }}</dd>
                        <dt>Capacité installée</dt>
                        <dd>{{ values.installedCapacity }} MWh</dd>
                        <dt>Tension de connexion</dt>
                        <dd>{{ values.voltageLevelConnection }} kV</dd>
                    </dl>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
